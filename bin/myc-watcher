#!/usr/bin/env python3
"""
Mycelium Watcher — push-delivers MQTT messages into agent terminals via Kitty send-text.

Subscribes to all topics, matches against subscriptions, looks up terminal windows
from presence registry, injects messages. No focus stealing, no accessibility hacks.

Rate limiting: burst (5 per target per 30s) + topic cap (20 per topic per 5min).
Anti-loop: only depth-0 messages get push-delivered.
"""

import subprocess
import sys
import os
import json
import time
import signal
import shutil
import threading
from pathlib import Path
from datetime import datetime

CONFIG_DIR = Path.home() / ".mycelium"
SUBS_FILE = CONFIG_DIR / "subscriptions.json"
PID_FILE = CONFIG_DIR / "watcher.pid"
CLIENT_ID = "mycelium-watcher"

MOSQUITTO_SUB = shutil.which("mosquitto_sub") or "/opt/homebrew/bin/mosquitto_sub"
KITTY = shutil.which("kitty") or "/opt/homebrew/bin/kitty"
WAIT_FOR_IDLE = shutil.which("wait-for-idle")

IDLE_THRESHOLD = 2  # seconds of keyboard/mouse inactivity before injecting
IDLE_TIMEOUT = 30   # give up waiting after this many seconds

# Rate limiting
BURST_LIMIT = 5
BURST_COOLDOWN = 30
TOPIC_CAP = 20
TOPIC_CAP_WINDOW = 300

# Conversation TTL — kill delivery on a topic after this many minutes of continuous activity
CONVERSATION_TTL = 30  # minutes

_burst_tracker = {}
_topic_tracker = {}
_topic_first_seen = {}  # topic → timestamp of first message in current active window
_inject_lock = threading.Lock()


def write_pid():
    PID_FILE.write_text(str(os.getpid()))

def remove_pid():
    PID_FILE.unlink(missing_ok=True)

def is_running():
    if not PID_FILE.exists():
        return False
    try:
        pid = int(PID_FILE.read_text().strip())
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError, ValueError):
        remove_pid()
        return False

def handle_signal(signum, frame):
    remove_pid()
    sys.exit(0)

def load_subs():
    if SUBS_FILE.exists():
        return json.loads(SUBS_FILE.read_text())
    return {}

def load_config():
    cfg_file = CONFIG_DIR / "config.json"
    if cfg_file.exists():
        return json.loads(cfg_file.read_text())
    return {}

def get_presences(client_id):
    """Look up all retained presences from presence/<client_id>/+.
    Returns list of dicts: [{'type': 'kitty', 'socket': '...', 'window_id': '...'}, ...]
    """
    results = []
    try:
        result = subprocess.run(
            [MOSQUITTO_SUB, "-h", "127.0.0.1", "-t", f"presence/{client_id}/+",
             "-W", "1", "-v"],
            capture_output=True, text=True, timeout=3
        )
        for line in result.stdout.strip().split("\n"):
            if not line.strip():
                continue
            parts = line.split(" ", 1)
            if len(parts) < 2 or not parts[1].strip():
                continue
            val = parts[1].strip()
            if val.startswith("kitty:"):
                vparts = val.split(":", 2)
                if len(vparts) == 3:
                    results.append({"type": "kitty", "socket": vparts[1], "window_id": vparts[2]})
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass
    return results

def window_exists_kitty(socket, window_id):
    try:
        result = subprocess.run(
            [KITTY, "@", "--to", f"unix:{socket}", "ls"],
            capture_output=True, text=True, timeout=3
        )
        data = json.loads(result.stdout)
        for os_win in data:
            for tab in os_win.get("tabs", []):
                for win in tab.get("windows", []):
                    if str(win["id"]) == str(window_id):
                        return True
    except Exception:
        pass
    return False

def detect_window_llm(socket, window_id):
    """Identify the LLM CLI running in a kitty window via foreground process
    cmdlines. Returns 'gemini', 'claude', 'codex', or None.

    Why: gemini-cli and codex interpret ESC as 'cancel current request' and
    abort any in-flight tool call. The vim-mode injection path leads with ESC,
    so delivering a spore mid-tool-call kills the run. Claude's vim editor mode
    tolerates the ESC; the others do not. Caller uses this to disable vim_mode
    for gemini/codex windows.
    """
    try:
        result = subprocess.run(
            [KITTY, "@", "--to", f"unix:{socket}", "ls"],
            capture_output=True, text=True, timeout=3
        )
        data = json.loads(result.stdout)
        for os_win in data:
            for tab in os_win.get("tabs", []):
                for win in tab.get("windows", []):
                    if str(win["id"]) != str(window_id):
                        continue
                    for proc in win.get("foreground_processes", []):
                        for arg in proc.get("cmdline", []):
                            base = arg.rsplit("/", 1)[-1]
                            if base == "gemini":
                                return "gemini"
                            if base == "claude":
                                return "claude"
                            # npm wrapper is codex.js; native binary is codex
                            if base == "codex" or base.startswith("codex.js") or base.startswith("codex-"):
                                return "codex"
    except Exception:
        pass
    return None

def _config_name(path):
    """agent_name from a .mycelium.json at `path`, or None."""
    cfg = path / ".mycelium.json"
    if not cfg.exists():
        return None
    try:
        name = json.loads(cfg.read_text()).get("agent_name", "")
        return name.replace("/", ".") if name else None
    except Exception:
        return None


def _derive_agent_from_cwd(cwd):
    """All plausible client_ids for an agent running in `cwd`.

    Returns a set, because the two things that create identities disagree:
    `myc-register` reads .mycelium.json only in the exact cwd, while `myc`
    (and `cx`) walk up to parents. A window under ~/majorbros/babylon is
    therefore 'majorbros.babylon' to one and 'helm' to the other. Accepting
    both keeps the delivery guard conservative — it only ever rejects when
    *no* reading of the directory could produce that agent name.
    """
    try:
        p = Path(cwd).resolve()
    except Exception:
        return set()
    names = set()
    # register-style: config in the exact directory only
    exact = _config_name(p)
    if exact:
        names.add(exact)
    # myc/cx-style: nearest config walking up
    for d in [p, *p.parents]:
        walked = _config_name(d)
        if walked:
            names.add(walked)
            break
        if (d / ".mycelium.json").exists():
            break
    # positional fallback: <parent>.<project>
    parts = p.parts
    if len(parts) >= 2:
        parent, proj = parts[-2], parts[-1]
        if parent in ("Users", "home", os.environ.get("USER", "")):
            names.add(proj.replace("/", "."))
        else:
            names.add(f"{parent}.{proj}")
    return names


def window_occupant(socket, window_id):
    """Which agent is *actually* sitting in this window right now?

    Derived from the live cwd of the LLM process in the window, not from the
    presence registry, so it stays honest even when the registry is stale.

    Note: the window-level `cwd` is the *shell's* and is useless here — it
    stays at the login directory while the agent runs somewhere else. Only the
    per-process cwd of the claude/codex/gemini process identifies the project.

    Returns None when it can't be determined — callers must fail open and
    deliver, since a wrong "no" would silently black-hole messages.
    """
    try:
        result = subprocess.run(
            [KITTY, "@", "--to", f"unix:{socket}", "ls"],
            capture_output=True, text=True, timeout=3
        )
        data = json.loads(result.stdout)
        for os_win in data:
            for tab in os_win.get("tabs", []):
                for win in tab.get("windows", []):
                    if str(win["id"]) != str(window_id):
                        continue
                    procs = win.get("foreground_processes", []) or []
                    for proc in procs:
                        cmdline = proc.get("cmdline", []) or []
                        if not cmdline:
                            continue
                        base = cmdline[0].rsplit("/", 1)[-1]
                        is_llm = base in ("claude", "gemini", "codex") or \
                            base.startswith("codex.js") or base.startswith("codex-")
                        if is_llm and proc.get("cwd"):
                            return _derive_agent_from_cwd(proc["cwd"])
                    # No LLM process identified — don't guess from the shell.
                    return None
    except Exception:
        pass
    return None


def presence_matches_window(client_id, occupants):
    """True if a message for client_id belongs in a window run by `occupants`.

    Worker identities are a base name plus a suffix (`helm-w98850`,
    `integrations.camel-codex`), so a prefix match on the base is correct.
    Empty/unknown occupants => True (fail open): a wrong rejection silently
    black-holes messages, which is worse than the stale-delivery bug itself.
    """
    if not occupants:
        return True
    return any(client_id == o or client_id.startswith(o + "-") for o in occupants)


def is_window_focused(socket, window_id):
    """Check if a kitty window is currently focused."""
    try:
        result = subprocess.run(
            [KITTY, "@", "--to", f"unix:{socket}", "ls"],
            capture_output=True, text=True, timeout=3
        )
        data = json.loads(result.stdout)
        for os_win in data:
            if not os_win.get("is_focused"):
                continue
            for tab in os_win.get("tabs", []):
                for win in tab.get("windows", []):
                    if str(win["id"]) == str(window_id) and win.get("is_focused"):
                        return True
    except Exception:
        pass
    return False


def wait_for_user_idle():
    """Wait for keyboard/mouse inactivity before injecting."""
    if not WAIT_FOR_IDLE:
        return
    try:
        subprocess.run(
            [WAIT_FOR_IDLE, str(IDLE_THRESHOLD), str(IDLE_TIMEOUT)],
            timeout=IDLE_TIMEOUT + 5
        )
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass


def _format_inject(sender, topic, message, action, ref=None):
    """Format a message for injection — single line, visually distinct."""
    # Extract short name (last part of sender path)
    short_name = sender.split("/")[-1] if "/" in sender else sender
    # Box-drawing brackets make it pop against regular text
    text = f"━━ {short_name} ━━ {message}"
    if ref:
        payloads_dir = Path.home() / ".mycelium" / "payloads"
        text += f" (+data: {payloads_dir}/{ref}.json)"
    return text


def _fragment_in_window_tail(socket, window_id, fragment, tail_lines=12):
    """True if `fragment` appears in the bottom `tail_lines` of the kitty
    window's visible screen — i.e., the input box area. Used to verify that
    send-text actually landed for TUIs (gemini-cli) that silently drop
    keystrokes when busy. False on any kitty/timeout error.
    """
    try:
        result = subprocess.run(
            [KITTY, "@", "--to", f"unix:{socket}", "get-text",
             "--match", f"id:{window_id}", "--extent", "screen"],
            capture_output=True, text=True, timeout=3
        )
        tail = "\n".join(result.stdout.splitlines()[-tail_lines:])
        return fragment in tail
    except Exception:
        return False


def inject_kitty(socket, window_id, text, action, vim_mode=True):
    """Inject via kitty @ send-text with stepped keystrokes."""
    full_text = text

    match_arg = f"id:{window_id}"
    sock_arg = f"unix:{socket}"

    def send(chars):
        subprocess.run(
            [KITTY, "@", "--to", sock_arg,
             "send-text", "--match", match_arg, chars],
            capture_output=True, text=True, timeout=5
        )

    try:
        if vim_mode:
            send("\x1b");  time.sleep(0.15)
            send("i");     time.sleep(0.15)
            send(full_text); time.sleep(0.3)
            send("\x1b");  time.sleep(0.3)
            send("\r");    time.sleep(0.3)
            send("i")
        else:
            # Non-vim (gemini-cli): TUI silently drops send-text while mid-
            # streaming. Verify the text landed in the input area before
            # submitting; retry once with a longer settle if not.
            fragment = full_text[:40].split("\n")[0]
            send(full_text); time.sleep(0.5)
            if fragment and not _fragment_in_window_tail(socket, window_id, fragment):
                log(f"inject retry (text didn't land in input): kitty:{window_id}")
                time.sleep(1.5)
                send(full_text); time.sleep(0.5)
            send("\r")
    except Exception as e:
        raise Exception(f"Kitty send-text failed: {e}")

def check_rate_limit(topic, client_id):
    """Returns (allowed, reason) tuple."""
    now = time.time()
    ttl_seconds = CONVERSATION_TTL * 60

    # Conversation TTL — if a topic has been continuously active too long, cut it off
    # Resets if topic has been quiet for 10+ minutes
    first_seen = _topic_first_seen.get(topic)
    topic_times_check = _topic_tracker.get(topic, [])
    last_activity = topic_times_check[-1] if topic_times_check else None
    if first_seen is None or (last_activity and now - last_activity > 600):
        _topic_first_seen[topic] = now
    elif now - first_seen > ttl_seconds:
        return False, f"conversation TTL ({CONVERSATION_TTL}min) — topic has been active too long"

    # Topic cap
    topic_times = _topic_tracker.get(topic, [])
    topic_times = [t for t in topic_times if now - t < TOPIC_CAP_WINDOW]
    _topic_tracker[topic] = topic_times
    if len(topic_times) >= TOPIC_CAP:
        return False, f"topic cap ({TOPIC_CAP}/{TOPIC_CAP_WINDOW}s)"

    # Burst limit
    key = (topic, client_id)
    burst_times = _burst_tracker.get(key, [])
    if burst_times and now - burst_times[-1] > BURST_COOLDOWN:
        burst_times = []
    burst_times = [t for t in burst_times if now - t < BURST_COOLDOWN]
    if len(burst_times) >= BURST_LIMIT:
        return False, f"burst limit ({BURST_LIMIT} in {BURST_COOLDOWN}s)"

    burst_times.append(now)
    _burst_tracker[key] = burst_times
    topic_times.append(now)
    _topic_tracker[topic] = topic_times
    return True, None

def process_message(topic, raw_payload):
    if topic.startswith("presence/"):
        return

    try:
        payload = json.loads(raw_payload)
        sender = payload.get("sender", "unknown")
        message = payload.get("message", raw_payload)
        action = payload.get("action", "notify")
        depth = payload.get("depth", 0)
        ref = payload.get("ref")
        embedded_presence = payload.get("sender_presence")
    except (json.JSONDecodeError, AttributeError):
        sender = "unknown"
        message = raw_payload
        action = "notify"
        depth = 0
        ref = None
        embedded_presence = None

    if depth > 0:
        log(f"Skipping depth-{depth} message on {topic} from {sender}")
        return

    if action not in ("notify", "prompt"):
        action = "notify"

    cfg = load_config()
    vim_mode = cfg.get("vim_mode", True)

    subs = load_subs()
    sender_client_id = sender.replace("/", ".")
    # Get sender's presence — try live lookup, fall back to embedded
    sender_windows = get_presences(sender_client_id)
    sender_presence = embedded_presence  # from payload, specific window that sent
    if not sender_presence and sender_windows:
        sender_presence = sender_windows[0]

    targets = []
    for agent, topics in subs.items():
        if topic in topics:
            agent_client_id = agent.replace("/", ".")
            if agent_client_id == sender_client_id:
                continue
            targets.append((agent, agent_client_id))

    if not targets:
        return

    # Format the injected message with visual structure
    inject_text = _format_inject(sender, topic, message, action, ref=ref)

    with _inject_lock:
        for agent, client_id in targets:
            allowed, reason = check_rate_limit(topic, client_id)
            if not allowed:
                log(f"Rate limited {client_id} on {topic}: {reason}")
                continue

            windows = get_presences(client_id)
            if not windows:
                log(f"No presence for {client_id}, skipping push (queued for absorb)")
                continue

            for presence in windows:
                # Window-level self-echo: skip if sender is in the same window
                if sender_presence and presence.get("type") == "kitty" and sender_presence.get("type") == "kitty":
                    if (presence.get("socket") == sender_presence.get("socket") and
                            presence.get("window_id") == sender_presence.get("window_id")):
                        log(f"Skipping {client_id} window {presence.get('window_id')}: same window as sender")
                        continue

                if presence["type"] == "kitty":
                    sock = presence["socket"]
                    wid = presence["window_id"]
                    if not window_exists_kitty(sock, wid):
                        log(f"Kitty window {wid} for {client_id} gone, skipping")
                        continue
                    # The window exists — but is it still this agent's window?
                    # Presences are retained forever and windows get reused, so
                    # a live-but-stale pointer would otherwise type one agent's
                    # messages into whoever inherited the terminal.
                    occupant = window_occupant(sock, wid)
                    if not presence_matches_window(client_id, occupant):
                        log(f"Stale presence for {client_id}: kitty:{wid} now "
                            f"belongs to {occupant}, skipping (queued for absorb)")
                        continue
                    # Only wait for idle if user is actively typing in this window
                    if is_window_focused(sock, wid):
                        wait_for_user_idle()
                    target_vim_mode = vim_mode
                    if detect_window_llm(sock, wid) in ("gemini", "codex"):
                        target_vim_mode = False
                    log(f"Injecting into {client_id} (kitty:{wid}, vim={target_vim_mode}): {message[:60]}...")
                    try:
                        inject_kitty(sock, wid, inject_text, action, target_vim_mode)
                    except Exception as e:
                        log(f"Injection failed for {client_id} window {wid}: {e}")

def log(msg):
    ts = datetime.now().strftime("%H:%M:%S")
    print(f"[{ts}] {msg}", flush=True)

def main():
    if "--check" in sys.argv:
        if is_running():
            print(f"Watcher running (PID {PID_FILE.read_text().strip()})")
            sys.exit(0)
        else:
            print("Watcher not running")
            sys.exit(1)

    if is_running():
        print(f"Watcher already running (PID {PID_FILE.read_text().strip()})")
        sys.exit(1)

    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    write_pid()
    log(f"Watcher started (PID {os.getpid()})")

    while True:
        try:
            proc = subprocess.Popen(
                [MOSQUITTO_SUB, "-h", "127.0.0.1", "-t", "#",
                 "-c", "-i", CLIENT_ID, "-v"],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
            )
            for line in proc.stdout:
                line = line.strip()
                if not line:
                    continue
                parts = line.split(" ", 1)
                if len(parts) < 2:
                    continue
                try:
                    process_message(parts[0], parts[1])
                except Exception as e:
                    log(f"Error processing message: {e}")
        except Exception as e:
            log(f"Watcher error: {e}, reconnecting in 5s...")
            time.sleep(5)

    remove_pid()

if __name__ == "__main__":
    main()
